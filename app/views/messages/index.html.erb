<h1>Mural de Recados</h1>

<% if @messages.empty? %>
     <p><b> Poxa... por enquanto sem recado, gostaria de deixar um?</b></p>
     <%= link_to "Novo recado", new_message_path %> 
<% end %>

<% @messages.each do |message| %>
    <div>
        <p><%= message.content %></p>
        <p><i> - <%= message.author %></i></p> 
    </div> 
<% end %>

